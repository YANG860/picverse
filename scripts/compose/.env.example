# rednote 测试容器凭据模板
# 用法：cp .env.example .env 并填写真实值（.env 不入库，见 .gitignore）
# 注意：以下凭据需与 config/config.yaml、test/testdb/db.go、test/e2e/media_e2e_test.go 保持一致

# PostgreSQL
POSTGRES_PASSWORD=
POSTGRES_DB=prod

# MinIO / S3
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=rednote

# Meilisearch（搜推服务；需与 config/config.yaml meili.api_key 一致，至少 16 字符）
MEILI_MASTER_KEY=
